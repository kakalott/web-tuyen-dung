# Python AI Service Environment Configuration

HOST=0.0.0.0
PORT=8001
DEBUG=true

# Bảo mật giao tiếp nội bộ giữa Backend và AI Service
INTERNAL_SERVICE_TOKEN=change_this_internal_secret_token_in_production

# Cấu hình Mô hình Embedding & Thuật toán
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MATCHING_ALGORITHM_VERSION=v1.2.0

# Giới hạn kích thước file PDF (đơn vị: bytes, ví dụ: 10485760 = 10MB)
MAX_PDF_SIZE_BYTES=10485760
MAX_PDF_PAGES=15
